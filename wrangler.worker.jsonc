{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irail-gtfs-rt",
  "main": "src/gtfs-rt/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "irail-cdn-data" }],
  // Cron has a one-minute granularity; every run polls twice, 30 s apart.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Open Belgian Mobility feed (no key), the default of the iRail API. Full snapshot of TripUpdates, ~100 KB.
    "GTFS_RT_URL": "https://sncb-opendata.hafas.de/gtfs/realtime/d22ad6759ee25bg84ddb6c818g4dc4de_TC",
    "GTFS_SOURCE_ID": "be.sncb",
    "PUBLIC_BASE_URL": "https://cdn.routableconnections.com"
  },
  "observability": { "enabled": true }
}
